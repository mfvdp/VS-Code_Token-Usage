{
  "name": "token-pace",
  "displayName": "%displayName%",
  "description": "%description%",
  "icon": "media/logo.png",
  "galleryBanner": {
    "color": "#1B2130",
    "theme": "dark"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "codex",
    "anthropic",
    "openai",
    "token",
    "usage",
    "quota",
    "rate limit",
    "cost",
    "status bar",
    "monitor",
    "burn rate",
    "forecast",
    "dashboard",
    "vscodium",
    "open vsx"
  ],
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/mfvdp/VS-Code_Token-Usage.git"
  },
  "bugs": {
    "url": "https://github.com/mfvdp/VS-Code_Token-Usage/issues"
  },
  "homepage": "https://github.com/mfvdp/VS-Code_Token-Usage#readme",
  "qna": "https://github.com/mfvdp/VS-Code_Token-Usage/issues",
  "version": "1.2.1",
  "publisher": "frederik",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "vscode": "^1.106.0"
  },
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "%capabilities.untrustedWorkspaces%"
    },
    "virtualWorkspaces": {
      "supported": true,
      "description": "%capabilities.virtualWorkspaces%"
    }
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "tokenPace",
          "title": "%viewsContainer.tokenPace.title%",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "tokenPace": [
        {
          "id": "tokenPace.dashboard",
          "name": "%view.tokenPace.dashboard.name%",
          "type": "webview"
        }
      ]
    },
    "colors": [
      {
        "id": "tokenPace.paceOk",
        "description": "%color.paceOk.description%",
        "defaults": {
          "dark": "#89D185",
          "light": "#388A34",
          "highContrast": "#89D185",
          "highContrastLight": "#388A34"
        }
      },
      {
        "id": "tokenPace.paceWarn",
        "description": "%color.paceWarn.description%",
        "defaults": {
          "dark": "#CCA700",
          "light": "#BF8803",
          "highContrast": "#CCA700",
          "highContrastLight": "#BF8803"
        }
      },
      {
        "id": "tokenPace.paceAhead",
        "description": "%color.paceAhead.description%",
        "defaults": {
          "dark": "#D18616",
          "light": "#D18616",
          "highContrast": "#D18616",
          "highContrastLight": "#D18616"
        }
      },
      {
        "id": "tokenPace.stale",
        "description": "%color.stale.description%",
        "defaults": {
          "dark": "descriptionForeground",
          "light": "descriptionForeground",
          "highContrast": "descriptionForeground",
          "highContrastLight": "descriptionForeground"
        }
      }
    ],
    "commands": [
      {
        "command": "tokenPace.showDashboard",
        "title": "%command.showDashboard.title%",
        "category": "%command.category%"
      },
      {
        "command": "tokenPace.showUsageQuickPick",
        "title": "%command.showUsageQuickPick.title%",
        "category": "%command.category%"
      },
      {
        "command": "tokenPace.showUsageMarkdown",
        "title": "%command.showUsageMarkdown.title%",
        "category": "%command.category%"
      },
      {
        "command": "tokenPace.menu",
        "title": "%command.menu.title%",
        "category": "%command.category%"
      },
      {
        "command": "tokenPace.rescan",
        "title": "%command.rescan.title%",
        "category": "%command.category%",
        "icon": "$(history)"
      },
      {
        "command": "tokenPace.showOutput",
        "title": "%command.showOutput.title%",
        "category": "%command.category%",
        "icon": "$(output)"
      },
      {
        "command": "tokenPace.refreshQuota",
        "title": "%command.refreshQuota.title%",
        "category": "%command.category%",
        "icon": "$(sync)",
        "enablement": "config.tokenPace.quotaSource != 'cache'"
      },
      {
        "command": "tokenPace.resetNetworkConsent",
        "title": "%command.resetNetworkConsent.title%",
        "category": "%command.category%"
      },
      {
        "command": "tokenPace.openSettings",
        "title": "%command.openSettings.title%",
        "category": "%command.category%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "tokenPace.openUsagePage",
        "title": "%command.openUsagePage.title%",
        "category": "%command.category%"
      },
      {
        "command": "tokenPace.cycleWindowSelect",
        "title": "%command.cycleWindowSelect.title%",
        "category": "%command.category%"
      },
      {
        "command": "tokenPace.exportCsv",
        "title": "%command.exportCsv.title%",
        "category": "%command.category%",
        "icon": "$(desktop-download)"
      },
      {
        "command": "tokenPace.exportJson",
        "title": "%command.exportJson.title%",
        "category": "%command.category%"
      },
      {
        "command": "tokenPace.copySummary",
        "title": "%command.copySummary.title%",
        "category": "%command.category%"
      },
      {
        "command": "tokenPace.copyDiagnostics",
        "title": "%command.copyDiagnostics.title%",
        "category": "%command.category%"
      },
      {
        "command": "tokenPace.clearStoredData",
        "title": "%command.clearStoredData.title%",
        "category": "%command.category%"
      },
      {
        "command": "tokenPace.previewStatusBar",
        "title": "%command.previewStatusBar.title%",
        "category": "%command.category%"
      },
      {
        "command": "tokenPace.connectStatusLine",
        "title": "%command.connectStatusLine.title%",
        "category": "%command.category%"
      },
      {
        "command": "tokenPace.disconnectStatusLine",
        "title": "%command.disconnectStatusLine.title%",
        "category": "%command.category%"
      },
      {
        "command": "tokenPace.setRange",
        "title": "%command.setRange.title%",
        "category": "%command.category%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tokenPace.refreshQuota",
          "when": "view == tokenPace.dashboard",
          "group": "navigation@1"
        },
        {
          "command": "tokenPace.rescan",
          "when": "view == tokenPace.dashboard",
          "group": "navigation@2"
        },
        {
          "command": "tokenPace.showOutput",
          "when": "view == tokenPace.dashboard",
          "group": "navigation@3"
        },
        {
          "command": "tokenPace.openSettings",
          "when": "view == tokenPace.dashboard",
          "group": "navigation@4"
        },
        {
          "command": "tokenPace.exportCsv",
          "when": "view == tokenPace.dashboard",
          "group": "1_export@1"
        }
      ],
      "commandPalette": [
        {
          "command": "tokenPace.setRange",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "tokenPace.showDashboard",
        "key": "ctrl+alt+shift+t",
        "mac": "cmd+alt+shift+t",
        "when": "config.tokenPace.keybindings"
      }
    ],
    "configuration": [
      {
        "id": "tokenPace.general",
        "title": "%configuration.general.title%",
        "order": 1,
        "properties": {
          "tokenPace.statusBar.show": {
            "type": "array",
            "order": 1,
            "default": [
              "claudeQuota",
              "codexQuota",
              "tokens"
            ],
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "claudeQuota",
                "codexQuota",
                "extra",
                "context",
                "tokens",
                "cost",
                "forecast",
                "budget"
              ],
              "enumDescriptions": [
                "%config.statusBar.show.enum.claudeQuota%",
                "%config.statusBar.show.enum.codexQuota%",
                "%config.statusBar.show.enum.extra%",
                "%config.statusBar.show.enum.context%",
                "%config.statusBar.show.enum.tokens%",
                "%config.statusBar.show.enum.cost%",
                "%config.statusBar.show.enum.forecast%",
                "%config.statusBar.show.enum.budget%"
              ]
            },
            "markdownDescription": "%config.statusBar.show.description%"
          },
          "tokenPace.windowSelect": {
            "type": "string",
            "order": 2,
            "enum": [
              "all",
              "leading",
              "worstPace",
              "session",
              "weekly",
              "auto"
            ],
            "default": "worstPace",
            "enumDescriptions": [
              "%config.windowSelect.enum.all%",
              "%config.windowSelect.enum.leading%",
              "%config.windowSelect.enum.worstPace%",
              "%config.windowSelect.enum.session%",
              "%config.windowSelect.enum.weekly%",
              "%config.windowSelect.enum.auto%"
            ],
            "markdownDescription": "%config.windowSelect.description%"
          },
          "tokenPace.density": {
            "type": "string",
            "order": 3,
            "enum": [
              "full",
              "compact",
              "minimal"
            ],
            "default": "full",
            "enumDescriptions": [
              "%config.density.enum.full%",
              "%config.density.enum.compact%",
              "%config.density.enum.minimal%"
            ],
            "markdownDescription": "%config.density.description%"
          },
          "tokenPace.clickAction": {
            "type": "string",
            "order": 4,
            "enum": [
              "dashboard",
              "menu",
              "refresh",
              "openWebsite"
            ],
            "default": "dashboard",
            "enumDescriptions": [
              "%config.clickAction.enum.dashboard%",
              "%config.clickAction.enum.menu%",
              "%config.clickAction.enum.refresh%",
              "%config.clickAction.enum.openWebsite%"
            ],
            "markdownDescription": "%config.clickAction.description%"
          },
          "tokenPace.usagePageLinks": {
            "type": "boolean",
            "order": 5,
            "default": true,
            "markdownDescription": "%config.usagePageLinks.description%"
          },
          "tokenPace.alignment": {
            "type": "string",
            "order": 6,
            "enum": [
              "left",
              "right"
            ],
            "default": "left",
            "enumDescriptions": [
              "%config.alignment.enum.left%",
              "%config.alignment.enum.right%"
            ],
            "markdownDescription": "%config.alignment.description%"
          },
          "tokenPace.staleAfterMinutes": {
            "type": "number",
            "order": 7,
            "default": 20,
            "minimum": 1,
            "maximum": 1440,
            "markdownDescription": "%config.staleAfterMinutes.description%"
          },
          "tokenPace.timezone": {
            "type": "string",
            "order": 8,
            "default": "system",
            "markdownDescription": "%config.timezone.description%"
          },
          "tokenPace.dayBoundaryHour": {
            "type": "number",
            "order": 9,
            "default": 0,
            "minimum": 0,
            "maximum": 23,
            "markdownDescription": "%config.dayBoundaryHour.description%"
          },
          "tokenPace.planName": {
            "type": "object",
            "order": 11,
            "default": {},
            "properties": {
              "claude": {
                "type": "string",
                "maxLength": 40,
                "description": "%config.planName.claude.description%"
              },
              "codex": {
                "type": "string",
                "maxLength": 40,
                "description": "%config.planName.codex.description%"
              }
            },
            "additionalProperties": false,
            "markdownDescription": "%config.planName.description%"
          },
          "tokenPace.keybindings": {
            "type": "boolean",
            "order": 10,
            "default": true,
            "markdownDescription": "%config.keybindings.description%"
          },
          "tokenPace.windows": {
            "type": "string",
            "order": 99,
            "enum": [
              "all",
              "leading"
            ],
            "default": "all",
            "enumDescriptions": [
              "%config.windows.enum.all%",
              "%config.windows.enum.leading%"
            ],
            "deprecationMessage": "%config.windows.deprecation%",
            "markdownDescription": "%config.windows.description%"
          }
        }
      },
      {
        "id": "tokenPace.pace",
        "title": "%configuration.pace.title%",
        "order": 2,
        "properties": {
          "tokenPace.pace.sensitivity": {
            "type": "string",
            "order": 1,
            "enum": [
              "relaxed",
              "normal",
              "strict",
              "custom"
            ],
            "default": "normal",
            "enumDescriptions": [
              "%config.pace.sensitivity.enum.relaxed%",
              "%config.pace.sensitivity.enum.normal%",
              "%config.pace.sensitivity.enum.strict%",
              "%config.pace.sensitivity.enum.custom%"
            ],
            "markdownDescription": "%config.pace.sensitivity.description%"
          },
          "tokenPace.pace.tolerancePoints": {
            "type": "number",
            "order": 2,
            "default": 5,
            "minimum": 0,
            "maximum": 20,
            "markdownDescription": "%config.pace.tolerancePoints.description%"
          },
          "tokenPace.pace.minElapsedPercent": {
            "type": "number",
            "order": 3,
            "default": 3,
            "minimum": 0,
            "maximum": 20,
            "markdownDescription": "%config.pace.minElapsedPercent.description%"
          },
          "tokenPace.pace.levels": {
            "type": "string",
            "order": 4,
            "enum": [
              "binary",
              "graded"
            ],
            "default": "binary",
            "enumDescriptions": [
              "%config.pace.levels.enum.binary%",
              "%config.pace.levels.enum.graded%"
            ],
            "markdownDescription": "%config.pace.levels.description%"
          }
        }
      },
      {
        "id": "tokenPace.statusBarLook",
        "title": "%configuration.statusBarLook.title%",
        "order": 3,
        "properties": {
          "tokenPace.barWidth": {
            "type": "number",
            "order": 1,
            "default": 8,
            "minimum": 0,
            "maximum": 20,
            "markdownDescription": "%config.barWidth.description%"
          },
          "tokenPace.barStyle": {
            "type": "string",
            "order": 2,
            "enum": [
              "line",
              "shade",
              "none"
            ],
            "default": "line",
            "enumDescriptions": [
              "%config.barStyle.enum.line%",
              "%config.barStyle.enum.shade%",
              "%config.barStyle.enum.none%"
            ],
            "markdownDescription": "%config.barStyle.description%"
          },
          "tokenPace.barGlyphs": {
            "type": "string",
            "order": 3,
            "enum": [
              "blocks",
              "shapes",
              "dots",
              "pie"
            ],
            "default": "blocks",
            "enumDescriptions": [
              "%config.barGlyphs.enum.blocks%",
              "%config.barGlyphs.enum.shapes%",
              "%config.barGlyphs.enum.dots%",
              "%config.barGlyphs.enum.pie%"
            ],
            "markdownDescription": "%config.barGlyphs.description%"
          },
          "tokenPace.timeProgressStyle": {
            "type": "string",
            "order": 4,
            "enum": [
              "marker",
              "bar",
              "none"
            ],
            "default": "marker",
            "enumDescriptions": [
              "%config.timeProgressStyle.enum.marker%",
              "%config.timeProgressStyle.enum.bar%",
              "%config.timeProgressStyle.enum.none%"
            ],
            "markdownDescription": "%config.timeProgressStyle.description%"
          },
          "tokenPace.indicator": {
            "type": "string",
            "order": 5,
            "enum": [
              "color",
              "glyph",
              "both",
              "none"
            ],
            "default": "both",
            "enumDescriptions": [
              "%config.indicator.enum.color%",
              "%config.indicator.enum.glyph%",
              "%config.indicator.enum.both%",
              "%config.indicator.enum.none%"
            ],
            "markdownDescription": "%config.indicator.description%"
          },
          "tokenPace.colorMode": {
            "type": "string",
            "order": 6,
            "enum": [
              "theme",
              "monochrome"
            ],
            "default": "theme",
            "enumDescriptions": [
              "%config.colorMode.enum.theme%",
              "%config.colorMode.enum.monochrome%"
            ],
            "markdownDescription": "%config.colorMode.description%"
          },
          "tokenPace.percentMode": {
            "type": "string",
            "order": 7,
            "enum": [
              "used",
              "remaining"
            ],
            "default": "used",
            "enumDescriptions": [
              "%config.percentMode.enum.used%",
              "%config.percentMode.enum.remaining%"
            ],
            "markdownDescription": "%config.percentMode.description%"
          },
          "tokenPace.resetFormat": {
            "type": "string",
            "order": 8,
            "enum": [
              "none",
              "relative",
              "absolute",
              "both"
            ],
            "default": "relative",
            "enumDescriptions": [
              "%config.resetFormat.enum.none%",
              "%config.resetFormat.enum.relative%",
              "%config.resetFormat.enum.absolute%",
              "%config.resetFormat.enum.both%"
            ],
            "markdownDescription": "%config.resetFormat.description%"
          },
          "tokenPace.showAgeInItem": {
            "type": "string",
            "order": 9,
            "enum": [
              "never",
              "whenStale",
              "always"
            ],
            "default": "whenStale",
            "enumDescriptions": [
              "%config.showAgeInItem.enum.never%",
              "%config.showAgeInItem.enum.whenStale%",
              "%config.showAgeInItem.enum.always%"
            ],
            "markdownDescription": "%config.showAgeInItem.description%"
          },
          "tokenPace.labels": {
            "type": "object",
            "order": 10,
            "default": {},
            "additionalProperties": {
              "type": "string",
              "maxLength": 40
            },
            "markdownDescription": "%config.labels.description%"
          },
          "tokenPace.summary.period": {
            "type": "string",
            "order": 11,
            "enum": [
              "today",
              "7d",
              "30d"
            ],
            "default": "today",
            "enumDescriptions": [
              "%config.summary.period.enum.today%",
              "%config.summary.period.enum.7d%",
              "%config.summary.period.enum.30d%"
            ],
            "markdownDescription": "%config.summary.period.description%"
          },
          "tokenPace.summary.scope": {
            "type": "string",
            "order": 12,
            "enum": [
              "both",
              "claude",
              "codex"
            ],
            "default": "both",
            "enumDescriptions": [
              "%config.summary.scope.enum.both%",
              "%config.summary.scope.enum.claude%",
              "%config.summary.scope.enum.codex%"
            ],
            "markdownDescription": "%config.summary.scope.description%"
          },
          "tokenPace.tooltip": {
            "type": "string",
            "order": 13,
            "enum": [
              "full",
              "compact",
              "off"
            ],
            "default": "full",
            "enumDescriptions": [
              "%config.tooltip.enum.full%",
              "%config.tooltip.enum.compact%",
              "%config.tooltip.enum.off%"
            ],
            "markdownDescription": "%config.tooltip.description%"
          },
          "tokenPace.tooltipExplanations": {
            "type": "boolean",
            "order": 14,
            "default": false,
            "markdownDescription": "%config.tooltipExplanations.description%"
          },
          "tokenPace.overflowDisplay": {
            "type": "string",
            "order": 90,
            "enum": [
              "clamp",
              "actual"
            ],
            "default": "actual",
            "enumDescriptions": [
              "%config.overflowDisplay.enum.clamp%",
              "%config.overflowDisplay.enum.actual%"
            ],
            "markdownDescription": "%config.overflowDisplay.description%"
          },
          "tokenPace.resetHourCycle": {
            "type": "string",
            "order": 91,
            "enum": [
              "auto",
              "h12",
              "h23"
            ],
            "default": "auto",
            "enumDescriptions": [
              "%config.resetHourCycle.enum.auto%",
              "%config.resetHourCycle.enum.h12%",
              "%config.resetHourCycle.enum.h23%"
            ],
            "markdownDescription": "%config.resetHourCycle.description%"
          },
          "tokenPace.labelMaxChars": {
            "type": "number",
            "order": 92,
            "default": 0,
            "minimum": 0,
            "maximum": 40,
            "markdownDescription": "%config.labelMaxChars.description%"
          }
        }
      },
      {
        "id": "tokenPace.dashboard",
        "title": "%configuration.dashboard.title%",
        "order": 4,
        "properties": {
          "tokenPace.dashboard.sections": {
            "type": "array",
            "order": 1,
            "default": [
              "quota",
              "summary",
              "kpis",
              "tokens",
              "chart",
              "models",
              "heatmap",
              "hours",
              "dataQuality"
            ],
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "quota",
                "summary",
                "context",
                "kpis",
                "tokens",
                "chart",
                "models",
                "heatmap",
                "hours",
                "records",
                "tools",
                "budget",
                "history",
                "projects",
                "sessions",
                "dataQuality"
              ],
              "enumDescriptions": [
                "%config.dashboard.sections.enum.quota%",
                "%config.dashboard.sections.enum.summary%",
                "%config.dashboard.sections.enum.context%",
                "%config.dashboard.sections.enum.kpis%",
                "%config.dashboard.sections.enum.tokens%",
                "%config.dashboard.sections.enum.chart%",
                "%config.dashboard.sections.enum.models%",
                "%config.dashboard.sections.enum.heatmap%",
                "%config.dashboard.sections.enum.hours%",
                "%config.dashboard.sections.enum.records%",
                "%config.dashboard.sections.enum.tools%",
                "%config.dashboard.sections.enum.budget%",
                "%config.dashboard.sections.enum.history%",
                "%config.dashboard.sections.enum.projects%",
                "%config.dashboard.sections.enum.sessions%",
                "%config.dashboard.sections.enum.dataQuality%"
              ]
            },
            "markdownDescription": "%config.dashboard.sections.description%"
          },
          "tokenPace.dashboard.defaultRange": {
            "type": "string",
            "order": 2,
            "enum": [
              "today",
              "7d",
              "30d",
              "90d",
              "thisWeek",
              "thisMonth",
              "lastMonth",
              "year",
              "all"
            ],
            "default": "30d",
            "enumDescriptions": [
              "%config.dashboard.defaultRange.enum.today%",
              "%config.dashboard.defaultRange.enum.7d%",
              "%config.dashboard.defaultRange.enum.30d%",
              "%config.dashboard.defaultRange.enum.90d%",
              "%config.dashboard.defaultRange.enum.thisWeek%",
              "%config.dashboard.defaultRange.enum.thisMonth%",
              "%config.dashboard.defaultRange.enum.lastMonth%",
              "%config.dashboard.defaultRange.enum.year%",
              "%config.dashboard.defaultRange.enum.all%"
            ],
            "markdownDescription": "%config.dashboard.defaultRange.description%"
          },
          "tokenPace.dashboard.modelRows": {
            "type": "number",
            "order": 3,
            "default": 12,
            "minimum": 0,
            "maximum": 500,
            "markdownDescription": "%config.dashboard.modelRows.description%"
          },
          "tokenPace.dashboard.topN": {
            "type": "number",
            "order": 4,
            "default": 5,
            "minimum": 1,
            "maximum": 20,
